{
  "version": 2,
  "builds": [
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/inquiry",
      "dest": "/api/inquiry.js"
    },
    {
      "src": "/api/leads",
      "dest": "/api/leads.js"
    },
    {
      "src": "/api/track",
      "dest": "/api/track.js"
    },
    {
      "src": "/api/auth/google",
      "dest": "/api/auth-google.js"
    },
    {
      "src": "/api/user/phone",
      "dest": "/api/user-phone.js"
    },
    {
      "src": "/api/bookings",
      "dest": "/api/bookings.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
