{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/inquiry",
      "destination": "/api/inquiry.js"
    },
    {
      "source": "/api/leads",
      "destination": "/api/leads.js"
    },
    {
      "source": "/api/track",
      "destination": "/api/track.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
