# EarthCone Home Nursing - Environment Configuration

# Server Port
PORT=3000

# Admin API Key (for viewing leads at /api/leads?key=YOUR_KEY)
ADMIN_API_KEY=earthcone-admin-2024

# Business Contact Details
BUSINESS_PHONE=+919931450495
BUSINESS_WHATSAPP=919931450495
BUSINESS_EMAIL=earthconehomenursing@gmail.com
BUSINESS_ADDRESS=Kalyan Nagar, Bengaluru, Karnataka - 560043

# Optional: Google Sheets Automated Lead Capture Webhook URL
# (Follow instructions in GoogleSheets_Webhook_Script.js to get this free URL)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/earthcone_nursing?retryWrites=true&w=majority

# Google Identity Services (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Secret for Client Portal Authentication Sessions
JWT_SECRET=super_secret_jwt_key_replace_with_random_string
